# HackEval Configuration

# Environment mode: 'development' allows synthetic test defaults, 'production' enforces zero TODOs
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-to-a-very-long-and-secure-random-key-64chars
APP_PORT=8000
APP_HOST=0.0.0.0

# Database (PostgreSQL for production, SQLite supported for local dev/testing)
DATABASE_URL=sqlite:///./hackeval.db
# DATABASE_URL=postgresql://hackeval:hackeval_secret@localhost:5432/hackeval

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
PRIVATE_GROUND_TRUTH_DIR=./data/ground_truth

# Security & SSRF Configuration
ALLOW_HTTP_MOCK_ENDPOINTS_IN_DEV=true
MAX_SUBMISSION_FILE_SIZE_BYTES=10485760 # 10MB
MAX_RESPONSE_BYTES=1048576 # 1MB

# Admin Seed
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@hackeval.local
INITIAL_ADMIN_PASSWORD=HackEvalAdmin2026!
MCP_ADMIN_API_KEY=mcp_secret_admintoken_7f8a9b2c3d4e5f6a

# Organizer Decision Approvals (Required for production launch)
DEADLINE_UTC=2026-10-02T12:00:00Z
LABEL_SET=category_a,category_b,category_c
EXPECTED_CASE_COUNT=500
PRELIMINARY_DATASET_VERSION=prelim-v1.0
FINALIST_TEST_SET_VERSION=hidden-v1.0
FINALIST_BATCH_SIZE=25
VERIFICATION_DEADLINE_SECONDS=1800
FINAL_TIEBREAKER=lowest_average_latency
